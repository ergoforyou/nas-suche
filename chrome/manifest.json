{
  "manifest_version": 3,
  "name": "ERGOFORYOU NAS-Suche",
  "short_name": "NAS-Suche",
  "version": "1.0.0",
  "description": "Wenn es schnell gehen muss: blitzschnelle Suche auf dem NAS – Dateien direkt in WhatsApp, Gmail, Drive oder Claude ziehen.",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "ERGOFORYOU NAS-Suche öffnen (Alt+Umschalt+F)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["nativeMessaging", "sidePanel", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true }
  ],
  "side_panel": { "default_path": "app.html?panel=1" },
  "commands": {
    "open-app": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "NAS-Suche als Tab öffnen" },
    "open-panel": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "NAS-Suche in der Seitenleiste öffnen" }
  }
}
