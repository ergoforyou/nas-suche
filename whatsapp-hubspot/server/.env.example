# Kopie dieser Datei als ".env" anlegen und ausfüllen. Die .env gehört NICHT ins Git.

# Öffentliche HTTPS-Adresse des Servers (Reverse Proxy auf der Synology), ohne / am Ende
PUBLIC_URL=https://wa.eure-firma.de

# Aus der HubSpot-App (Entwicklerprojekt "whatsapp-hubspot" → App → Auth):
HUBSPOT_TOKEN=pat-eu1-...
HUBSPOT_CLIENT_SECRET=...
# Euer HubSpot-Konto – Anfragen aus anderen Konten werden abgewiesen
HUBSPOT_PORTAL_ID=146305116

# Passwort für die Admin-Seite (QR-Code). Mindestens 12 Zeichen, Benutzername egal.
ADMIN_PASSWORT=

# ---------- Optionale Einstellungen (Standardwerte stehen dahinter) ----------

# Unbekannte Nummern, die schreiben, automatisch als Kontakt anlegen (true/false)
AUTO_ANLEGEN=true

# Chronik am Kontakt: tag = ein Eintrag pro Kunde und Tag | nachricht = jede Nachricht einzeln | aus
TIMELINE=tag
# Sekunden, die nach der letzten Nachricht gewartet wird, bevor der Tages-Eintrag aktualisiert wird
TIMELINE_VERZOEGERUNG_SEK=60

# Namen des HubSpot-Nutzers fett vor jede gesendete Nachricht setzen ("*Erika Muster:*")
NAME_IN_NACHRICHT=false

# Schutz gegen versehentlichen Massenversand
MAX_NACHRICHTEN_PRO_TAG=200

# Bilder/Dateien bis zu dieser Größe auf der NAS speichern
MAX_MEDIEN_MB=25

# Beim ersten Verbinden den älteren Verlauf vom Telefon übernehmen
VERLAUF_IMPORT=true

LANDESVORWAHL=49
ZEITZONE=Europe/Berlin
LOG_LEVEL=info
