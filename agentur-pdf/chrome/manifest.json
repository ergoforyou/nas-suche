{
  "manifest_version": 3,
  "name": "Ergoforyou PDF",
  "short_name": "Ergoforyou PDF",
  "version": "0.12.1",
  "description": "PDFs in Chrome direkt mit Ergoforyou PDF öffnen und bearbeiten – statt Chromes PDF-Anzeige. Dazu Seitenleiste zum Zusammenführen und Google-Drive-Knopf.",
  "key": "",
  "icons": {
    "16": "symbole/symbol16.png",
    "32": "symbole/symbol32.png",
    "48": "symbole/symbol48.png",
    "128": "symbole/symbol128.png"
  },
  "action": {
    "default_title": "Ergoforyou PDF",
    "default_icon": {
      "16": "symbole/symbol16.png",
      "32": "symbole/symbol32.png"
    }
  },
  "side_panel": {
    "default_path": "seitenleiste.html"
  },
  "background": {
    "service_worker": "hintergrund.js"
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Ergoforyou-PDF-Seitenleiste öffnen"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://drive.google.com/*"
      ],
      "js": [
        "drive.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
