{
  "manifest_version": 3,
  "name": "ERGOFORYOU Datei-Explorer",
  "short_name": "Datei-Explorer",
  "version": "1.1.0",
  "description": "Explorer mit zwei Ansichten und blitzschneller Suche – Dateien verschieben, umbenennen, löschen und direkt in WhatsApp, Gmail, Drive oder Claude ziehen.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "ERGOFORYOU Datei-Explorer öffnen (Alt+Umschalt+E)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "app.html?panel=1"
  },
  "commands": {
    "open-app": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Datei-Explorer als Tab öffnen"
    },
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Datei-Explorer in der Seitenleiste öffnen"
    }
  }
}