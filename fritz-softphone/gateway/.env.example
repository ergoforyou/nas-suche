# IP-Adresse der FRITZ!Box
FRITZBOX_HOST=192.168.178.1

# In der FRITZ!Box unter Telefonie > Telefoniegeräte > Neues Gerät > "Telefon (mit und ohne Anrufbeantworter)" > LAN/WLAN (IP-Telefon) angelegt
FRITZ_SIP_USER=browserphone
FRITZ_SIP_PASSWORD=bitte-aendern

# Zugangsdaten, mit denen sich die Chrome-Erweiterung am Gateway anmeldet
WEBPHONE_USER=webphone
WEBPHONE_PASSWORD=bitte-auch-aendern

# Optional
HTTP_PORT=8088
SIP_PORT=5070
RTP_START=10000
RTP_END=10200

# Nebenstellen-Monitor (Callmonitor der FRITZ!Box, vorher #96*5* wählen)
MONITOR_PORT=8089
# Optional: Zugriffsschutz, in der Erweiterung dann ?token=... an die Monitor-Adresse hängen
MONITOR_TOKEN=
