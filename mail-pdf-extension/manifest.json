{
  "manifest_version": 3,
  "name": "E-Mail → PDF (mit Anhängen)",
  "short_name": "Mail→PDF",
  "version": "1.4.0",
  "description": "Speichert eine E-Mail aus Outlook Web oder Gmail per Rechtsklick als eine PDF – inklusive aller Anhänge.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "debugger",
    "downloads",
    "storage",
    "scripting",
    "webRequest",
    "activeTab"
  ],
  "host_permissions": [
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://mail.google.com/*",
    "https://graph.microsoft.com/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "content/bridge-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "E-Mail als PDF speichern (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Aktuelle E-Mail als PDF speichern"
    }
  },
  "options_page": "options/options.html"
}
