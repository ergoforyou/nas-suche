{
  "manifest_version": 3,
  "name": "Whiteboard – Ablage für Screenshots, Snippets & Dateien",
  "short_name": "Whiteboard",
  "version": "1.0.0",
  "description": "Ein Whiteboard im Browser: Screenshots, Text-Snippets, Links und ganze Dateien ablegen, sortieren und im Blick behalten.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Whiteboard öffnen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "board.html"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "favicon",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Whiteboard öffnen"
    },
    "capture-tab": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Screenshot des aktuellen Tabs aufs Whiteboard legen"
    }
  }
}
