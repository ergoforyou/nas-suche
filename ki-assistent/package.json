{
  "name": "ki-assistent",
  "productName": "KI-Assistent",
  "version": "1.12.0",
  "description": "Lokaler Desktop-Assistent mit Avatar, Spracherkennung und Sprachausgabe für LM Studio",
  "main": "main.js",
  "author": "ergoforyou",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --win portable nsis",
    "dist:mac": "node build.mjs && electron-builder --mac dmg",
    "dist:linux": "node build.mjs && electron-builder --linux AppImage",
    "test": "node test/smoke.mjs && node test/bild2vrm.mjs && node test/cutout.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@huggingface/transformers": "3.8.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "@pixiv/three-vrm": "^3.5.5",
    "docx": "^9.11.0",
    "dompurify": "3.3.0",
    "electron": "38.8.6",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.11",
    "marked": "16.4.1",
    "onnxruntime-web": "1.18.0",
    "playwright": "1.56.1",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "de.ergoforyou.kiassistent",
    "productName": "KI-Assistent",
    "files": [
      "main.js",
      "preload.js",
      "cloud.js",
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "KI-Assistent-${version}-Setup.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "category": "Utility"
    },
    "portable": {
      "artifactName": "KI-Assistent-${version}-portable.${ext}"
    },
    "extraResources": [
      {
        "from": "tts-server",
        "to": "tts-server"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "openai": "7.33.0"
  },
  "edition": "cloud"
}
